{
  "type": "object",
  "properties": {
    "detected_type": { "type": "string", "enum": ["word", "phrase", "sentence", "paragraph"] },
    "original_text": { "type": "string" },
    "summary": { "type": "string", "description": "该词在语境中的核心含义一句话" },
    "translation": {
      "type": "object",
      "properties": {
        "literal": { "type": "string" },
        "natural": { "type": "string" }
      }
    },
    "word_info": {
      "type": "object",
      "properties": {
        "word": { "type": "string" },
        "ipa_us": { "type": "string" },
        "ipa_uk": { "type": "string" },
        "pos": { "type": "string", "description": "当前句中词性" },
        "core_meanings": { "type": "array", "items": { "type": "string" } },
        "context_meaning": { "type": "string" },
        "morphology": { "type": "string", "description": "词根词缀构词；不确定必须说明" },
        "inflections": { "type": "array", "items": { "type": "string" } },
        "derivatives": {
          "type": "array",
          "items": { "type": "object", "properties": { "word": { "type": "string" }, "meaning": { "type": "string" } }, "required": ["word", "meaning"] }
        },
        "grammar_role": { "type": "string", "description": "句中语法作用：修饰谁/为什么这个位置/能否替换" },
        "compare": {
          "type": "array",
          "items": { "type": "object", "properties": { "expression": { "type": "string" }, "difference": { "type": "string" } }, "required": ["expression", "difference"] }
        },
        "usage": {
          "type": "object",
          "properties": {
            "examples": { "type": "array", "items": { "type": "string" } },
            "collocations": { "type": "array", "items": { "type": "string" } },
            "synonyms": { "type": "array", "items": { "type": "string" } },
            "antonyms": { "type": "array", "items": { "type": "string" } },
            "confusables": { "type": "array", "items": { "type": "string" } },
            "scenarios": { "type": "string" }
          },
          "required": ["examples", "collocations"]
        }
      },
      "required": ["word", "pos", "core_meanings", "context_meaning"]
    },
    "vocabulary": {
      "type": "array",
      "description": "word 模式一般省略（信息已在 word_info）",
      "items": { "type": "object" }
    }
  },
  "required": ["detected_type", "original_text", "summary", "word_info"]
}
