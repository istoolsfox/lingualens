{
  "generate": {
    "type": "object",
    "properties": {
      "questions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "description": "q1, q2, ..." },
            "type": { "type": "string", "enum": ["word_meaning", "phrase_meaning", "grammar_choice", "translation", "imitation", "synonym", "correction"] },
            "prompt": { "type": "string", "description": "题干（含来源句/原句）" },
            "options": { "type": "array", "items": { "type": "string" }, "description": "选择题四选项；主观题省略" },
            "answer": { "type": "string", "description": "选择题为正确选项文本；主观题为参考答案" },
            "explanation": { "type": "string" }
          },
          "required": ["id", "type", "prompt", "answer", "explanation"]
        }
      }
    },
    "required": ["questions"]
  },
  "grade": {
    "type": "object",
    "properties": {
      "gradings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "questionId": { "type": "string" },
            "verdict": { "type": "string", "enum": ["correct", "partial", "wrong"] },
            "comment": { "type": "string", "description": "肯定+问题+改进版" }
          },
          "required": ["questionId", "verdict", "comment"]
        }
      },
      "overall_comment": { "type": "string" }
    },
    "required": ["gradings"]
  }
}
