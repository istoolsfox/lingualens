{
  "manifest_version": 3,
  "name": "LinguaLens — AI 英语深度阅读助手",
  "version": "0.4.0",
  "description": "选中即精读：不止翻译，讲透英语为什么这样表达。单词构词、句中语法作用、意群拆解、双轨翻译、表达习惯与中英差异。",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LinguaLens",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "translate-article": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Command+Shift+L"
      },
      "description": "翻译本文：智能提取正文逐段双语翻译"
    }
  }
}
