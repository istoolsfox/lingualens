{
  "name": "lingualens",
  "version": "0.5.0",
  "private": true,
  "description": "LinguaLens —— AI 英语深度阅读助手：选中即精读的 Chrome 扩展",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "watch:main": "vite build --watch",
    "watch:content": "vite build --config vite.content.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "zip": "node scripts/zip.mjs",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "fake-server": "node scripts/fake-ai-server.mjs",
    "e2e": "node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.1.6",
    "idb": "^8.0.1",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.41",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}
